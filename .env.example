# ==============================================================================
# NOVA — Natural-language Organizer & Virtual Assistant Configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to Git!
# ==============================================================================

# --- 1. Core Application Settings ---
APP_NAME="NOVA"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8000
TIMEZONE="Asia/Kuala_Lumpur"
LOG_LEVEL="INFO"

# --- 2. Security & Access Control ---
# Your personal WhatsApp phone number in international format WITHOUT '+' or spaces
# Example for Malaysia: 60123456789
ALLOWED_WHATSAPP_NUMBER="60123456789"

# Secret token you invent for Meta Webhook verification (can be any random string)
WHATSAPP_VERIFY_TOKEN="replace_with_your_custom_verify_string"

# Meta App Secret (Found in Meta Developer Dashboard -> App Settings -> Basic)
# Used to verify X-Hub-Signature-256 HMAC payload authenticity
WHATSAPP_APP_SECRET="replace_with_meta_app_secret"

# Enforce HMAC-SHA256 webhook signature verification (Keep true in production)
VERIFY_WEBHOOK_SIGNATURE=true

# --- 3. WhatsApp Cloud API Credentials ---
# Found in Meta Developer Dashboard -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN="replace_with_meta_access_token"
WHATSAPP_PHONE_NUMBER_ID="replace_with_meta_phone_number_id"
WHATSAPP_API_VERSION="v22.0"

# --- 4. Local AI (Ollama) Configuration ---
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_SECONDS=90

# --- 5. Database Configuration ---
DATABASE_PATH="data/jarvis.db"

# --- 6. Google Calendar OAuth 2.0 ---
GOOGLE_CLIENT_SECRET_FILE="credentials/client_secret.json"
GOOGLE_TOKEN_FILE="credentials/token.json"
GOOGLE_CALENDAR_ID="primary"
# Automatically attach native Google Calendar popup/email reminders (minutes before event)
# so your phone alerts you even when your laptop is powered off!
GOOGLE_CALENDAR_DEFAULT_REMINDER_MINUTES=30

# --- 7. Reminder, Quiet Hours & Fallback Delivery ---
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START="23:00"
QUIET_HOURS_END="07:00"

# Send a keepalive prompt at hour 23 of the 24h WhatsApp customer service window
WHATSAPP_WINDOW_KEEPALIVE_ENABLED=true

# Windows Desktop Toast Notifications (Local fallback when on laptop)
DESKTOP_NOTIFICATIONS_ENABLED=true

# Optional Email Fallback (Gmail SMTP with App Password - 100% Free, works when 24h WA window is closed)
EMAIL_FALLBACK_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_APP_PASSWORD=""
FALLBACK_RECIPIENT_EMAIL=""

# --- 8. Daily Briefing Settings ---
MORNING_BRIEFING_ENABLED=true
MORNING_BRIEFING_TIME="08:00"
